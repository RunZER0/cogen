# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
DATABASE_BACKEND=sqlite
SQLITE_PATH=./venture_twin.db

# Google AI / ADK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
RESEARCH_MODE=offline

# Google Cloud (set these for Firestore / Cloud Run)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
FIRESTORE_DATABASE=(default)
