# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# Persistence: sqlite for local demos; postgres for Neon/Cloud Run
DATABASE_BACKEND=sqlite
SQLITE_PATH=./venture_twin.db
DATABASE_URL=

# Google AI / ADK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
RESEARCH_MODE=offline
SPECIALIST_MODE=orchestrated
LIVE_SPECIALIST_LIMIT=5

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
