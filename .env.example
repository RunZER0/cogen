# Runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080

# Persistence: sqlite for local demos; postgres for Neon/Cloud Run
DATABASE_BACKEND=sqlite
SQLITE_PATH=./venture_twin.db
DATABASE_URL=

# Google AI / ADK
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
RESEARCH_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
RESEARCH_MODE=offline
SPECIALIST_MODE=orchestrated
LIVE_SPECIALIST_LIMIT=5

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Google Maps Platform — Places API (New), for real named local competitors near the venture's
# actual address rather than generic web search. Create a key at console.cloud.google.com,
# enable "Places API (New)", and restrict it to that API. Optional: find_local_competitors
# reports a clear error (and the agent falls back to search_web) when this is unset.
GOOGLE_MAPS_API_KEY=
